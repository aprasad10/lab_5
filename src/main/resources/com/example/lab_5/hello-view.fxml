<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<ScrollPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.example.lab_5.BankAccountController">
   <content>
      <VBox alignment="CENTER" spacing="20.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Button fx:id="createAcc" depthTest="ENABLE" onAction="#onCreateAccButtonClick" text="Create Account" />
            <Label fx:id="account" text="Account" />
            <Button fx:id="deposit" mnemonicParsing="false" onAction="#onDepositButtonClick" text="Deposit" />
            <Button fx:id="withdraw" mnemonicParsing="false" onAction="#onWithdrawButtonClick" text="Withdraw" />
            <TextField fx:id="amount" />
            <Label fx:id="balance" text="Balance: " />
            <Button fx:id="statement" mnemonicParsing="false" onAction="#onStatementButtonClick" text="Print Statement" />
            <Label fx:id="print" />
            <ComboBox fx:id="accountSelector" onAction="#onSelectAccountButtonClick" prefWidth="150.0" promptText="Select Account" />
         </children>
      </VBox>
   </content>
</ScrollPane>
